# Firebase — pegá acá los valores del objeto firebaseConfig de la consola.
# (Project settings → General → Your apps → SDK setup and configuration)
# Copiá este archivo a `.env` y completá. NO subas `.env` a git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend OrixChat (NestJS)
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# Giphy (opcional, para el picker de GIFs) — https://developers.giphy.com
VITE_GIPHY_KEY=
